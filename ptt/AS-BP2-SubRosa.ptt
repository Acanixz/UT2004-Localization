[LevelInfo0]
; EN: Title="Sub Rosa"
Title="Sub Rosa"

[LevelSummary]
; EN: Title="Sub Rosa"
Title="Sub Rosa"
; EN: Description="Every rose has thorns, and even the most pristine worlds can hide sinister intentions."
Description="Toda rosa tem espinhos, e até os mundos mais prístinos podem esconder intenções sinistras."

[SceneSubtitles0]
; EN: SubTitles=("This scenario recreates the invasion of the Central Liandri Information compound by N.E.G. forces.","The New Earth Government discovered that the Liandri were transferring experimental weapons data through the facility, and sent an elite squad in to retrieve the research.","The attackers must first make their way to the compound and destroy the main gate to get into the courtyard.",,"Then you must destroy the front door controls to gain access to the main building.",,"Once inside, you must make your way to the central office to get the keys to the vault.",,"Next, use the keys to open the vault doors.",,"Once inside the vault, you must destroy the protective shield around the data stick.","Then, you must deliver the data stick to the access station in order to realign the antenna.",,"Finally, you must move the updated data from the antenna to the terminal, and transmit the weapon data to the N.E.G.",)
SubTitles=("Este cenário recria a invasão da Composto de Informações Central Liandri pelas forças do G.N.T.","O Governo da Nova Terra descobriu que os Liandri estavam transferindo dados de armas experimentais através da instalação, e enviou um esquadrão de elite para recuperar a pesquisa.","Os atacantes devem primeiro seguir até a instalação e destruir a porta principal para entrar no pátio.",,"Então vocês devem destruir os controles da porta frontal para obter acesso ao prédio principal.",,"Assim que estiverem dentro, devem seguir até o escritório central para obter as chaves do cofre.",,"Em seguida, use as chaves para abrir as portas do cofre.",,"Assim que estiverem dentro do cofre, devem destruir o escudo protetor ao redor do cartão de dados.","Então, devem entregar o cartão de dados à estação de acesso para realinhar a antena.",,"Por fim, devem mover os dados atualizados da antena para o terminal, e transmitir os dados das armas ao G.N.T.",)

