[PhysicsVolume0]
; EN: LocationName="Conveyor blets"
LocationName="Esteiras de transporte"

[SceneSubtitles1]
; EN: SubTitles=("Somewhere deep in the Australian outback...",,"trouble is brewing.",,"First, your team will need to open the Pub's drainage valve and get rid of the old Zero Beer.",,"Next, destroy the Zero Beer billboards to ruin their marketing campaign.",,"In order to make new beer, you'll need to engage the lake's pumps and restore the flow of fresh water into the Brewery.",,"Once the water is flowing, your team must storm the Brewery's main gates.",,"When you're inside, open the intake valve to pump the fresh water into the brewing tanks.",,"Find the missing Hops canister and add it to the Brew cycle.",,"Once the hops are in, someone will need to activate the main switch and start the stirring paddles of the brew kettles.",,"Finally, open the main valve to fill up the fermentation tanks with fresh beer.",)
SubTitles=("Nas profundezas do outback Australiano...",,"encrenca está surgindo.",,"Primeiro, sua equipe precisará abrir a válvula de drenagem do Pub e se livrar da velha Cerveja Zero.",,"Em seguida, destrua os outdoors da Cerveja Zero para arruinar a campanha de marketing deles.",,"Para fazer nova cerveja, você precisará ativar as bombas do lago e restaurar o fluxo de água fresca para a Cervejaria.",,"Quando a água estiver fluindo, sua equipe deve invadir os portões principais da Cervejaria.",,"Quando estiver dentro, abra a válvula de entrada para bombear a água fresca para os tanques de fermentação.",,"Encontre o recipiente de lúpulo perdido e adicione-o ao ciclo de fermentação.",,"Uma vez que o lúpulo está dentro, alguém precisará ativar o interruptor principal e iniciar as pás de mistura das caldeiras de produção.",,"Finalmente, abra a válvula principal para encher os tanques de fermentação com cerveja fresca.",)

